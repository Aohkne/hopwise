# --- OpenRouter: CHỈ dùng cho Jev -----------------------------
# Lấy key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jev là "decisions model": KHÔNG dùng được với /chat/completions.
# Phải gọi endpoint riêng /api/alpha/decisions với payload {state, questions}.
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_DECISIONS_PATH=/alpha/decisions
JEV_MODEL=typesafe/jev-1.13

# --- LLM baseline: gọi THẲNG API từng hãng -----------------------------
# Model dạng <hãng>/<model>, cách nhau bằng dấu phẩy. Hãng: openai, google, deepseek.
BASELINE_MODELS=google/gemini-3.8-flash
# BASELINE_MODELS=openai/gpt-6-sol,google/gemini-3.8-flash,deepseek/deepseek-v4.1-flash

# Chỉ cần key của hãng có model trong BASELINE_MODELS. Lấy key tại:
#   OpenAI   https://platform.openai.com/api-keys
#   Google   https://aistudio.google.com/apikey
#   DeepSeek https://platform.deepseek.com/api_keys
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Giới hạn thời gian mỗi model trong 1 lượt benchmark (giây).
BENCH_TIMEOUT_SECONDS=300
BENCH_CHUNK=250

# --- Neo4j -----------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123
NEO4J_DATABASE=neo4j
