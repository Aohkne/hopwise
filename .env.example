# ---------------------------------------------------------------------------
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- OpenRouter (cách gọi Jev rẻ nhất hiện tại) ---------------------------
# Lấy key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jev là "decisions model": KHÔNG dùng được với /chat/completions.
# Phải gọi endpoint riêng /api/alpha/decisions với payload {state, questions}.
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_DECISIONS_PATH=/alpha/decisions
JEV_MODEL=typesafe/jev-1.13

# Model LLM dùng để so sánh trong benchmark (gọi qua /v1/chat/completions)
BASELINE_MODELS=openai/gpt-6-sol,google/gemini-3.8-flash,deepseek/deepseek-v4.1-flash

# Header tuỳ chọn của OpenRouter (hiện lên leaderboard, để trống cũng được)
OPENROUTER_APP_TITLE=JEV-KG-Benchmark
OPENROUTER_SITE_URL=

# --- Gọi thẳng TypeSafe (tuỳ chọn, cần nạp tiền tại console.typesafe.ai) ---
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone

# --- Kev: bản open-source chạy local, API giống hệt Jev (MIỄN PHÍ) -----------
# github.com/jaredpalmer/kev — khởi động bằng:
#   uv run --extra serve python -m kev.serve --run jaredpalmer/kev-4b --port 8009
# Cùng schema {state, questions} nên harness chỉ cần đổi base_url là so sánh được.
KEV_BASE_URL=http://127.0.0.1:8009
KEV_MODEL=kev-latest
# Đặt giá trị nếu server chạy với KEV_API_KEY (mặc định server mở, không cần key)
KEV_API_KEY=

# --- Neo4j (chạy bằng `docker compose up -d`) -----------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123
NEO4J_DATABASE=neo4j

# --- Tuỳ chọn benchmark ---------------------------------------------------
# Số nhánh giữ lại mỗi hop khi traversal (1 = greedy, >1 = beam search)
BEAM_WIDTH=1
# Số hop tối đa trước khi dừng
MAX_HOPS=4
