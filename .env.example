# --- OpenRouter -----------------------------
# Lấy key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jev là "decisions model": KHÔNG dùng được với /chat/completions.
# Phải gọi endpoint riêng /api/alpha/decisions với payload {state, questions}.
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_DECISIONS_PATH=/alpha/decisions
JEV_MODEL=typesafe/jev-1.13

# --- Gemma 4 12B(LOCAL) -----------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4-12b
OLLAMA_REASONING_EFFORT=none

# --- gpt-oss-20b(NVIDIA NIM) -----------------------------
# Lấy key tại https://build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b

# Giới hạn thời gian mỗi model trong 1 lượt benchmark (giây).
BENCH_TIMEOUT_SECONDS=300
BENCH_CHUNK=250

# --- Neo4j -----------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123
NEO4J_DATABASE=neo4j
